    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080d1a"
      }
    },
    "web": {
      "favicon": "./dewan-foto.jpg"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
